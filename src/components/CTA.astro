---
import { site } from '../data/site';
interface Props { title?: string; text?: string }
const { title = 'Máy in đang gặp lỗi?', text = 'Gọi hoặc nhắn Zalo, gửi kèm hình máy để được tư vấn nhanh.' } = Astro.props;
---

<section class="mx-auto my-12 max-w-6xl px-4">
  <div class="flex flex-col items-start gap-4 rounded-2xl bg-amber-50 p-8 ring-1 ring-amber-200 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="text-2xl font-bold">{title}</h2>
      <p class="mt-1 text-slate-700">{text}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={`tel:${site.hotlineTel}`} class="rounded-lg bg-accent px-5 py-3 font-bold text-slate-900 hover:bg-amber-400">Gọi {site.hotline}</a>
      <a href={site.zalo} rel="nofollow noopener" class="rounded-lg bg-brand px-5 py-3 font-bold text-white hover:bg-brand-dark">Nhắn Zalo</a>
    </div>
  </div>
</section>
