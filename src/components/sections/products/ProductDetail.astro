---
import ProductTabBtn from '@components/ui/buttons/ProductTabBtn.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import SecondaryCTA from '@components/ui/buttons/SecondaryCTA.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { site } from '@data/site';

/** Trang 1 dòng máy in cũ: trưng bày, hỏi mua qua Gọi/Zalo (không giỏ hàng). */
interface Props {
  product: CollectionEntry<'products'>;
}
const { product } = Astro.props;
const { copy: t } = Astro.locals;
const d = product.data;
const tabs = [
  { id: 'tabs-with-card-item-1', dataTab: '#tabs-with-card-1', title: 'Phù hợp với ai' },
  { id: 'tabs-with-card-item-2', dataTab: '#tabs-with-card-2', title: 'Kiểm tra trước khi bán' },
  ...(d.models.length
    ? [{ id: 'tabs-with-card-item-3', dataTab: '#tabs-with-card-3', title: 'Model thường có' }]
    : []),
];
---

<div id="overlay" class="pointer-events-none fixed inset-0 bg-neutral-200 dark:bg-neutral-800"></div>

<section class="mx-auto flex max-w-[85rem] flex-col px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
  <p id="fadeText" class="mb-8 max-w-prose font-light text-pretty text-neutral-700 sm:text-xl dark:text-neutral-300">
    {d.intro}
  </p>
  <div class="flex flex-col items-center justify-between gap-8 sm:flex-row">
    <div id="fadeInUp">
      <h1 class="block text-4xl font-bold tracking-tighter text-neutral-800 sm:text-5xl md:text-6xl dark:text-neutral-200">
        {d.cardTitle}
      </h1>
      <p class="mt-2 text-lg text-neutral-600 dark:text-neutral-400">{d.description}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <PrimaryCTA title={`${t.contact.call} ${site.hotline}`} url={`tel:${site.hotlineTel}`} variant="yellow" noArrow />
        <SecondaryCTA title="Hỏi máy còn hàng qua Zalo" url={site.zalo} />
      </div>
    </div>
    <div class="overflow-hidden rounded-xl">
      <Image
        id="fadeInMoveRight"
        src={d.image}
        class="w-[600px] will-change-transform"
        alt={d.imageAlt}
        width={600}
        loading={'eager'}
      />
    </div>
  </div>
</section>

<div id="product-detail-body" class="mx-auto max-w-[85rem] px-4 pt-10 sm:px-6 lg:px-8 lg:pt-14">
  <nav class="mx-auto grid max-w-6xl gap-y-px sm:flex sm:gap-x-4 sm:gap-y-0" aria-label={t.products.tabs} role="tablist">
    {tabs.map((tab, index) => (
      <ProductTabBtn title={tab.title} id={tab.id} dataTab={tab.dataTab} first={index === 0} />
    ))}
  </nav>

  <div class="relative mt-12 md:mt-16">
    <div id="tabs-with-card-1" class="product-tab-panel" role="tabpanel">
      <div class="mx-auto grid max-w-[85rem] gap-8 px-4 pb-10 sm:px-6 md:grid-cols-2 lg:px-8 lg:pb-14">
        {d.suitableFor.map(item => (
          <div>
            <h3 class="text-base font-bold text-neutral-800 sm:text-lg dark:text-neutral-200">{item.title}</h3>
            <p class="mt-1 text-neutral-600 dark:text-neutral-400">{item.subTitle}</p>
          </div>
        ))}
      </div>
    </div>

    <div id="tabs-with-card-2" class="product-tab-panel hidden" role="tabpanel">
      <div class="mx-auto grid max-w-[85rem] gap-8 px-4 pb-10 sm:px-6 md:grid-cols-2 lg:px-8 lg:pb-14">
        {d.checks.map(item => (
          <div>
            <h3 class="font-bold text-neutral-800 dark:text-neutral-200">{item.title}</h3>
            <p class="text-neutral-600 dark:text-neutral-400">{item.subTitle}</p>
          </div>
        ))}
      </div>
    </div>

    {d.models.length > 0 && (
      <div id="tabs-with-card-3" class="product-tab-panel hidden" role="tabpanel">
        <div class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14">
          <p class="text-neutral-600 dark:text-neutral-400">
            Các model hay có tại cửa hàng (hàng thay đổi theo đợt — gọi để hỏi máy đang có):
          </p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {d.models.map(m => (
              <li class="rounded-lg bg-neutral-100 px-3 py-1.5 text-sm font-medium text-neutral-700 dark:bg-white/[.05] dark:text-neutral-300">{m}</li>
            ))}
          </ul>
        </div>
      </div>
    )}
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const parts = ['#fadeText', '#fadeInUp', '#fadeInMoveRight', '#product-detail-body'];

  if (reduce) {
    gsap.set(parts, { clearProps: 'all' });
    gsap.set('#overlay', { autoAlpha: 0, display: 'none' });
  } else {
    gsap.set('#fadeText', { autoAlpha: 0, y: 20 });
    gsap.set('#fadeInUp', { autoAlpha: 0, y: 28 });
    gsap.set('#fadeInMoveRight', { autoAlpha: 0, x: 56, scale: 0.97 });
    gsap.set('#product-detail-body', { autoAlpha: 0, y: 24 });
    const reveal = () => {
      gsap.set(parts, { autoAlpha: 1, x: 0, y: 0, scale: 1 });
      gsap.set('#overlay', { autoAlpha: 0, display: 'none' });
    };
    const safety = window.setTimeout(reveal, 2200);
    gsap
      .timeline({
        defaults: { ease: 'power3.out' },
        onComplete: () => {
          window.clearTimeout(safety);
          gsap.set('#overlay', { display: 'none' });
        },
      })
      .to('#overlay', { autoAlpha: 0, duration: 0.65, ease: 'power2.inOut' }, 0.08)
      .to('#fadeText', { autoAlpha: 1, y: 0, duration: 0.85 }, 0.12)
      .to('#fadeInUp', { autoAlpha: 1, y: 0, duration: 0.95 }, 0.22)
      .to('#fadeInMoveRight', { autoAlpha: 1, x: 0, scale: 1, duration: 1.05 }, 0.18)
      .to('#product-detail-body', { autoAlpha: 1, y: 0, duration: 0.8 }, 0.42);
  }

  const active = ['active', 'bg-neutral-100', 'hover:border-transparent', 'dark:bg-white/[.05]'];
  const on = ['text-orange-400', 'dark:text-orange-300'];
  const off = ['text-neutral-800', 'dark:text-neutral-200'];
  const buttons = document.querySelectorAll('[data-target]');

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const target = button.getAttribute('data-target');
      const panel = target ? (document.querySelector(target) as HTMLElement | null) : null;
      if (!panel) return;
      buttons.forEach(b => {
        b.classList.remove(...active);
        b.querySelector('span')?.classList.remove(...on);
        b.querySelector('span')?.classList.add(...off);
      });
      button.classList.add(...active);
      button.querySelector('span')?.classList.remove(...off);
      button.querySelector('span')?.classList.add(...on);
      document.querySelectorAll('.product-tab-panel').forEach(p => p.classList.add('hidden'));
      panel.classList.remove('hidden');
    });
  });
</script>
