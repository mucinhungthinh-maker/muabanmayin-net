---
import { site } from '../data/site';
interface Props { title: string; subtitle: string }
const { title, subtitle } = Astro.props;
---

<section class="bg-gradient-to-br from-brand to-brand-dark text-white">
  <div class="mx-auto max-w-6xl px-4 py-14 md:py-20">
    <h1 class="max-w-3xl text-3xl font-extrabold leading-tight md:text-5xl">{title}</h1>
    <p class="mt-4 max-w-2xl text-lg text-blue-100">{subtitle}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={`tel:${site.hotlineTel}`} class="rounded-lg bg-accent px-6 py-3 text-lg font-bold text-slate-900 hover:bg-amber-400">Gọi {site.hotline}</a>
      <a href={site.zalo} rel="nofollow noopener" class="rounded-lg border-2 border-white px-6 py-3 text-lg font-bold hover:bg-white hover:text-brand">Nhắn Zalo</a>
    </div>
    <slot />
  </div>
</section>
