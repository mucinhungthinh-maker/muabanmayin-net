---
// Nhúng YouTube kiểu "lite": chỉ tải iframe khi bấm → không ảnh hưởng tốc độ trang.
interface Props { id: string; title: string }
const { id, title } = Astro.props;
---

<div class="yt relative aspect-video overflow-hidden rounded-2xl bg-black" data-id={id}>
  <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt={title} width="480" height="360" loading="lazy" class="h-full w-full object-cover opacity-80" />
  <button type="button" class="absolute inset-0 flex items-center justify-center" aria-label={`Phát video: ${title}`}>
    <span class="rounded-2xl bg-red-600 px-6 py-3 text-2xl text-white">▶</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.yt').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      el.innerHTML = `<iframe class="absolute inset-0 h-full w-full" src="https://www.youtube-nocookie.com/embed/${el.dataset.id}?autoplay=1" title="YouTube" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
    });
  });
</script>
