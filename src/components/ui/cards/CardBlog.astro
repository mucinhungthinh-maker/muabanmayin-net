---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@utils/utils';
import { pathFor } from '@utils/content';

interface Props {
  blogEntry: CollectionEntry<'blog'>;
}
const { blogEntry } = Astro.props;
const label = {
  'sua-may-in': 'Sửa máy in',
  'may-in-cu': 'Máy in cũ',
  'thu-mua-may-in': 'Thu mua',
}[blogEntry.data.category];
---

<a
  class="group relative block rounded-xl ring-zinc-500 outline-hidden transition duration-500 focus-visible:ring-3 dark:ring-zinc-200"
  href={pathFor(blogEntry)}
  data-astro-prefetch
>
  <div class="relative h-[350px] w-full shrink-0 overflow-hidden rounded-xl before:absolute before:inset-x-0 before:z-1 before:size-full before:bg-linear-to-t before:from-neutral-900/[.75]">
    <Image
      class="absolute start-0 top-0 size-full object-cover transition duration-500 group-hover:scale-110"
      src={blogEntry.data.cardImage}
      alt={blogEntry.data.cardImageAlt}
      width={800}
      draggable={'false'}
      loading="lazy"
    />
  </div>
  <div class="absolute inset-x-0 top-0 z-10 p-4 sm:p-6">
    <span class="inline-block rounded-full bg-yellow-400 px-3 py-1 text-xs font-bold text-neutral-800">{label}</span>
    <p class="mt-2 text-xs text-neutral-50/[.85]">{formatDate(blogEntry.data.pubDate)}</p>
  </div>
  <div class="absolute inset-x-0 bottom-0 z-10 p-4 sm:p-6">
    <h3 class="text-lg font-bold text-balance text-neutral-50 group-hover:text-neutral-50/[.8] sm:text-2xl">
      {blogEntry.data.title}
    </h3>
    <p class="mt-2 line-clamp-2 text-pretty text-neutral-50/[.85]">{blogEntry.data.description}</p>
  </div>
</a>
