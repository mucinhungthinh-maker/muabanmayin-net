---
import { Image } from 'astro:assets';
import Icon from '@components/ui/icons/Icon.astro';
import type { CollectionEntry } from 'astro:content';
import { pathFor } from '@utils/content';

/** Thẻ dòng máy in cũ; `wide` chiếm 2 cột. */
interface Props {
  product: CollectionEntry<'products'>;
  wide?: boolean;
}
const { product, wide = false } = Astro.props;
---

<a
  href={pathFor(product)}
  data-astro-prefetch
  class:list={[
    'group relative flex h-56 items-end overflow-hidden ring-zinc-500 outline-hidden focus-visible:ring-3 md:h-80 dark:ring-zinc-200',
    wide ? 'rounded-lg shadow-xl md:col-span-2' : 'rounded-xl shadow-lg',
  ]}
>
  <Image
    src={product.data.image}
    alt={product.data.imageAlt}
    width={wide ? 1100 : 600}
    draggable={'false'}
    class="absolute inset-0 h-full w-full object-cover object-center transition duration-[600ms] ease-[cubic-bezier(0.45,0,0.55,1)] group-hover:scale-110"
  />
  <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-neutral-900 via-transparent to-transparent opacity-70"></div>
  <span class="relative mb-3 ml-4 inline-block text-base font-bold text-neutral-50 transition duration-[600ms] ease-[cubic-bezier(0.45,0,0.55,1)] group-hover:scale-105 md:ml-5 md:text-xl">
    {product.data.cardTitle}
    <Icon name="openInNew" class="ml-0.5 inline h-3 w-3 pb-0.5 md:h-4 md:w-4" />
  </span>
</a>
