# Copy thành .env rồi điền. KHÔNG commit file .env
# Token bot mới tạo từ @BotFather (bot riêng cho web, không dùng chung bot kỹ thuật)
TELEGRAM_BOT_TOKEN=
# Chat ID được phép gửi bài, cách nhau dấu phẩy. Để trống → bot chỉ trả lời chat id của anh.
ALLOWED_CHAT_IDS=
# 1 = tự build + git push sau mỗi bài; 0 = chỉ lưu bài, đẩy tay bằng DAY-WEB.bat
AUTO_PUSH=1
