---
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import { site } from '@data/site';
interface Props {
  title?: string;
  subTitle?: string;
}
const {
  title = 'Máy in đang gặp lỗi?',
  subTitle = 'Gọi hoặc nhắn Zalo, gửi kèm hình máy để được tư vấn và báo giá nhanh.',
} = Astro.props;
const { copy: t } = Astro.locals;
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
  <div class="relative overflow-hidden rounded-2xl bg-neutral-800 px-6 py-12 sm:px-12 dark:bg-neutral-900">
    <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-yellow-400/20 blur-3xl" aria-hidden="true"></div>
    <div class="relative flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold text-balance text-neutral-50 md:text-4xl">{title}</h2>
        <p class="mt-3 text-pretty text-neutral-300">{subTitle}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <PrimaryCTA title={`${t.contact.call} ${site.hotline}`} url={`tel:${site.hotlineTel}`} variant="yellow" noArrow />
        <a
          href={site.zalo}
          rel="nofollow noopener"
          class="inline-flex items-center justify-center gap-x-2 rounded-lg border border-neutral-500 px-4 py-3 text-sm font-bold text-neutral-50 transition duration-300 hover:bg-neutral-700 2xl:text-base"
        >
          {t.contact.zalo}
        </a>
      </div>
    </div>
  </div>
</section>
