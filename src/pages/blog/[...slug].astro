---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    // Bài liên quan: ưu tiên cùng chuyên mục, rồi đến bài mới nhất
    const same = posts.filter((p) => p.id !== post.id && p.data.category === post.data.category);
    const other = posts.filter((p) => p.id !== post.id && p.data.category !== post.data.category);
    return { params: { slug: post.id }, props: { post, related: [...same, ...other].slice(0, 3) } };
  });
}

const { post, related } = Astro.props;
const { Content } = await render(post);
---

<PostLayout post={post} related={related}>
  <Content />
</PostLayout>
