---
import MainLayout from '@/layouts/MainLayout.astro';
import MainSection from '@components/ui/blocks/MainSection.astro';
import Breadcrumb from '@components/ui/blocks/Breadcrumb.astro';
import AlternatingSections, { type Article } from '@components/ui/blocks/AlternatingSections.astro';
import StepsSection from '@components/sections/misc/StepsSection.astro';
import CTASection from '@components/sections/misc/CTASection.astro';
import { services, images } from '@data/content';
import { site } from '@data/site';

const crumbs = [{ name: 'Dịch vụ', path: '/dich-vu/' }];

const articles: Article[] = [
  {
    title: 'Sửa máy in laser, máy in phun',
    subTitle: `${services[0].long} Lỗi hay gặp: ${services[0].points.join('; ').toLowerCase()}.`,
    images: [...services[0].images],
  },
  {
    title: 'Bán máy in cũ đã kiểm tra',
    subTitle: services[1].long,
    images: [{ src: images.mayInBan, alt: 'Máy in phun Epson đang in ảnh màu' }],
    cta: { title: 'Xem các dòng máy in cũ', url: '/may-in-cu/' },
  },
  {
    title: 'Thu mua máy in cũ, máy hỏng',
    subTitle: services[2].long,
    images: [
      { src: images.mayInCuaSo, alt: 'Máy in laser HP cũ trong văn phòng' },
      { src: images.mayInSanGo, alt: 'Máy in phun đa năng cũ đặt trên sàn gỗ' },
    ],
    cta: { title: 'Cách bán máy in cũ', url: '/thu-mua-may-in/' },
  },
  {
    title: 'Vệ sinh, bảo dưỡng định kỳ',
    subTitle:
      'Máy in văn phòng in nhiều nên vệ sinh đường giấy, trống và cụm sấy định kỳ để hạn chế kẹt giấy và bản in mờ. Kỹ thuật viên kiểm tra và báo các linh kiện sắp hết tuổi thọ để anh chị chủ động thay.',
    images: [{ src: images.mayInCan, alt: 'Bên trong máy in phun với các hộp mực màu' }],
  },
];
---

<MainLayout
  title="Dịch vụ sửa máy in, bán & thu mua máy in Quận 12"
  description="Sửa máy in laser, máy in phun các hãng; bán máy in cũ đã kiểm tra; thu mua máy in cũ, máy hỏng. Chi nhánh Tô Ký, Quận 12."
  breadcrumbs={crumbs}
>
  <Breadcrumb items={crumbs} />
  <MainSection
    title="Dịch vụ máy in tại chi nhánh Tô Ký, Quận 12"
    subTitle="Ba việc chính: sửa chữa, bán máy in cũ và thu mua máy in cũ. Mang máy đến cửa hàng hoặc gọi để được tư vấn trước."
    cta={{ title: `Gọi ${site.hotline}`, url: `tel:${site.hotlineTel}` }}
  />
  <AlternatingSections articles={articles} />
  <StepsSection title="Quy trình sửa máy in" />
  <CTASection />
</MainLayout>
