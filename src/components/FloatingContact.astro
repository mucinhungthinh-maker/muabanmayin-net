---
import Icon from '@components/ui/icons/Icon.astro';
import { site } from '@data/site';
const { copy: t } = Astro.locals;
---

{/* Mobile: thanh Gọi/Zalo cố định đáy màn hình. Desktop: 2 nút tròn góc phải dưới. */}
<div class="fixed inset-x-0 bottom-0 z-60 grid grid-cols-2 shadow-[0_-4px_14px_rgba(0,0,0,.15)] md:inset-x-auto md:right-5 md:bottom-5 md:flex md:flex-col md:gap-3 md:shadow-none">
  <a
    href={`tel:${site.hotlineTel}`}
    class="flex items-center justify-center gap-2 bg-yellow-400 py-3.5 text-base font-bold text-neutral-800 hover:bg-yellow-500 md:rounded-full md:px-5 md:py-3 md:shadow-lg"
  >
    <Icon name="phone" class="h-5 w-5" />
    {t.contact.call} {site.hotline}
  </a>
  <a
    href={site.zalo}
    rel="nofollow noopener"
    class="flex items-center justify-center gap-2 bg-neutral-800 py-3.5 text-base font-bold text-neutral-50 hover:bg-neutral-700 md:rounded-full md:px-5 md:py-3 md:shadow-lg dark:bg-neutral-700"
  >
    <Icon name="chatBubble" class="h-5 w-5" />
    {t.contact.chatZalo}
  </a>
</div>
