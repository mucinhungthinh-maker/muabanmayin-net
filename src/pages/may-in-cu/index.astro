---
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumb from '@components/ui/blocks/Breadcrumb.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import CardProduct from '@components/ui/cards/CardProduct.astro';
import CardRelated from '@components/ui/cards/CardRelated.astro';
import CTASection from '@components/sections/misc/CTASection.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { services } from '@data/content';
import { site } from '@data/site';
import { getPosts, getProducts } from '@utils/content';

const products = await getProducts();
const posts = (await getPosts('may-in-cu')).slice(0, 3);
const crumbs = [{ name: 'Máy in cũ', path: '/may-in-cu/' }];
---

<MainLayout
  title="Máy in cũ giá tốt tại Tô Ký, Quận 12"
  description="Bán máy in cũ HP, Canon, Brother, Epson đã kiểm tra, vệ sinh và in thử trước khi giao. Xem máy trực tiếp tại chi nhánh Tô Ký, Quận 12."
  breadcrumbs={crumbs}
>
  <Breadcrumb items={crumbs} />
  <div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
    <div class="mb-8 flex flex-col gap-6 md:mb-12 md:flex-row md:items-center md:justify-between">
      <div class="max-w-2xl">
        <h1 class="text-3xl font-bold tracking-tight text-balance text-neutral-800 md:text-5xl md:leading-tight dark:text-neutral-200">
          Máy in cũ tại Tô Ký, Quận 12
        </h1>
        <p class="mt-3 text-pretty text-neutral-600 dark:text-neutral-400">
          {services[1].summary} Hàng thay đổi theo đợt — gọi trước để hỏi máy đang có.
        </p>
      </div>
      <PrimaryCTA title={`Hỏi máy còn hàng: ${site.hotline}`} url={`tel:${site.hotlineTel}`} variant="yellow" noArrow />
    </div>
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-3 md:gap-6 xl:gap-8">
      {products.map((product, index) => (
        <CardProduct product={product} wide={index % 4 === 1 || index % 4 === 2} />
      ))}
    </section>
  </div>

  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl font-bold text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200">
          Máy được chuẩn bị thế nào trước khi bán
        </h2>
        <p class="mt-3 text-pretty text-neutral-600 dark:text-neutral-400">
          Không bán máy "nguyên trạng". Mỗi máy đều qua các bước kiểm tra để anh chị mua về là dùng được ngay.
        </p>
      </div>
      <ul class="space-y-4">
        {services[1].points.map(p => (
          <li class="flex gap-3 text-neutral-700 dark:text-neutral-300">
            <Icon name="checkCircle" class="mt-0.5 h-6 w-6 shrink-0 text-orange-400" />
            {p}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
      <h2 class="mb-8 text-2xl font-bold text-neutral-800 md:text-3xl dark:text-neutral-200">Kinh nghiệm chọn máy in cũ</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{posts.map(p => <CardRelated blogEntry={p} />)}</div>
    </section>
  )}

  <CTASection title="Đang tìm máy in cũ?" subTitle="Cho biết nhu cầu in (trắng đen hay màu, bao nhiêu trang mỗi ngày, có cần scan) để được tư vấn máy phù hợp." />
</MainLayout>
