---
import Meta from '@components/Meta.astro';
import Navbar from '@components/sections/navbar&footer/Navbar.astro';
import FooterSection from '@components/sections/navbar&footer/FooterSection.astro';
import FloatingContact from '@components/FloatingContact.astro';
import {
  buildPageMetadata,
  type Crumb,
  type PageKind,
} from '@utils/metadata';
import '@styles/global.css';

/**
 * Khung chung mọi trang. Trang chỉ khai báo title/description/loại trang,
 * layout tự sinh <head> (SEO + schema) qua buildPageMetadata().
 */
interface Props {
  /** Tiêu đề đầy đủ ≤ 60 ký tự. Bỏ trống ở trang chủ. */
  title?: string;
  description?: string;
  ogTitle?: string;
  ogImage?: ImageMetadata;
  kind?: PageKind;
  breadcrumbs?: Crumb[];
  faqs?: { question: string; answer: string }[];
  noindex?: boolean;
  hideFooter?: boolean;
}

const { hideFooter = false, ogImage, ...meta } = Astro.props;
const { locale, copy: t } = Astro.locals;

const metadata = buildPageMetadata({
  locale,
  pathname: Astro.url.pathname,
  ...meta,
});
---

<html
  lang={metadata.lang}
  class="scrollbar-hide lenis lenis-smooth scroll-pt-16"
>
  <head>
    <Meta metadata={metadata} ogImage={ogImage} />
    <script is:inline>
      // Giao diện tối: theo lựa chọn đã lưu hoặc theo cài đặt máy
      if (
        localStorage.getItem('hs_theme') === 'dark' ||
        (!('hs_theme' in localStorage) &&
          window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
    <script>
      import '@scripts/lenisSmoothScroll.js';
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-neutral-200 pb-14 selection:bg-yellow-400 selection:text-neutral-700 md:pb-0 dark:bg-neutral-800">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:bg-yellow-400 focus:px-4 focus:py-2 focus:text-neutral-800"
    >
      {t.layout.skipToContent}
    </a>
    <div class="mx-auto w-full max-w-(--breakpoint-2xl) grow px-4 sm:px-6 lg:px-8">
      <Navbar />
      <main id="main-content">
        <slot />
      </main>
    </div>
    {!hideFooter && <FooterSection />}
    <FloatingContact />
    <script>
      // https://preline.co
      import 'preline';
      const init = () =>
        (
          window as Window & { HSStaticMethods?: { autoInit?: () => void } }
        ).HSStaticMethods?.autoInit?.();
      if (document.readyState === 'loading')
        document.addEventListener('DOMContentLoaded', init);
      else init();
    </script>
    <style>
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }
      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </body>
</html>
