---
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumb from '@components/ui/blocks/Breadcrumb.astro';
import PriceTable from '@components/ui/blocks/PriceTable.astro';
import CTASection from '@components/sections/misc/CTASection.astro';

const crumbs = [{ name: 'Bảng giá', path: '/bang-gia/' }];
---

<MainLayout
  title="Bảng giá sửa máy in tham khảo – Tô Ký, Quận 12"
  description="Bảng giá tham khảo sửa máy in, vệ sinh, thay linh kiện tại chi nhánh Tô Ký, Quận 12. Báo giá chính xác sau khi kiểm tra máy."
  breadcrumbs={crumbs}
>
  <Breadcrumb items={crumbs} />
  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <h1 class="text-3xl font-bold tracking-tight text-balance text-neutral-800 md:text-5xl dark:text-neutral-200">
      Bảng giá sửa máy in tham khảo
    </h1>
    <p class="mt-4 text-lg text-pretty text-neutral-600 dark:text-neutral-400">
      Giá thay đổi theo model và tình trạng linh kiện. Kỹ thuật viên kiểm tra và báo giá trước, anh chị đồng ý mới làm.
    </p>
    <div class="mt-8"><PriceTable /></div>
    <p class="mt-8 text-neutral-700 dark:text-neutral-300">
      Cần bán máy cũ? Xem <a class="font-bold text-orange-400 hover:underline" href="/thu-mua-may-in/">thu mua máy in</a>.
      Cần mua máy? Xem <a class="font-bold text-orange-400 hover:underline" href="/may-in-cu/">máy in cũ</a>.
    </p>
  </section>
  <CTASection />
</MainLayout>
