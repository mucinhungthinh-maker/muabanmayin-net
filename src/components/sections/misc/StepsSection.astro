---
import { steps } from '@data/content';
interface Props {
  title: string;
  subTitle?: string;
}
const { title, subTitle } = Astro.props;
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
  <div class="mb-10 max-w-2xl">
    <h2 class="text-2xl font-bold text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200">
      <Fragment set:html={title} />
    </h2>
    {subTitle && <p class="mt-2 text-pretty text-neutral-600 dark:text-neutral-400">{subTitle}</p>}
  </div>
  <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {steps.map((s, i) => (
      <li class="relative rounded-xl bg-neutral-100 p-6 dark:bg-white/[.05]">
        <span class="text-5xl font-extrabold text-yellow-400">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-3 text-lg font-bold text-neutral-800 dark:text-neutral-200">{s.title}</h3>
        <p class="mt-1 text-neutral-600 dark:text-neutral-400">{s.text}</p>
      </li>
    ))}
  </ol>
</section>
