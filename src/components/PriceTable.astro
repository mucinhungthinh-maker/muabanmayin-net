---
import { prices } from '../data/content';
interface Props { limit?: number }
const { limit } = Astro.props;
const rows = limit ? prices.slice(0, limit) : prices;
---

<div class="overflow-x-auto rounded-xl border border-slate-200">
  <table class="w-full text-left text-base">
    <thead class="bg-slate-100 text-slate-700">
      <tr><th scope="col" class="px-4 py-3">Hạng mục</th><th scope="col" class="px-4 py-3 whitespace-nowrap">Giá tham khảo</th><th scope="col" class="hidden px-4 py-3 sm:table-cell">Ghi chú</th></tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr class="border-t border-slate-200">
          <td class="px-4 py-3">{r.item}</td>
          <td class="px-4 py-3 font-semibold whitespace-nowrap">{r.price}</td>
          <td class="hidden px-4 py-3 text-slate-600 sm:table-cell">{r.note}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="mt-3 text-sm text-slate-600">Giá tham khảo, báo giá chính xác sau khi kiểm tra máy.</p>
