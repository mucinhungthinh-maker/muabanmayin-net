---
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumb from '@components/ui/blocks/Breadcrumb.astro';
import CardBlog from '@components/ui/cards/CardBlog.astro';
import CardBlogRecent from '@components/ui/cards/CardBlogRecent.astro';
import CTASection from '@components/sections/misc/CTASection.astro';
import { getPosts } from '@utils/content';

const [mostRecent, ...others] = await getPosts();
const crumbs = [{ name: 'Kinh nghiệm', path: '/blog/' }];
---

<MainLayout
  title="Kinh nghiệm sửa máy in & mua máy in cũ"
  description="Ca sửa máy in thực tế, kinh nghiệm chọn mua máy in cũ, cách định giá khi bán máy in cũ — từ kỹ thuật viên chi nhánh Tô Ký, Quận 12."
  breadcrumbs={crumbs}
>
  <Breadcrumb items={crumbs} />
  <section class="mx-auto max-w-[85rem] space-y-8 px-4 pt-10 sm:px-6 lg:px-8 2xl:max-w-full">
    <div class="mx-auto max-w-3xl text-left sm:text-center">
      <h1 class="block text-4xl font-bold tracking-tight text-balance text-neutral-800 md:text-5xl dark:text-neutral-200">
        Kinh nghiệm sửa máy in & mua bán máy in cũ
      </h1>
      <p class="mt-4 text-lg text-pretty text-neutral-600 dark:text-neutral-400">
        Ca sửa thực tế có hình ảnh, video từ kỹ thuật viên; kinh nghiệm chọn máy in cũ và bán lại máy cũ.
      </p>
    </div>
  </section>

  {mostRecent ? (
    <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
      <CardBlogRecent blogEntry={mostRecent} />
    </section>
  ) : (
    <p class="py-10 text-center text-neutral-600 dark:text-neutral-400">Bài viết đang được cập nhật.</p>
  )}

  {others.length > 0 && (
    <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
      <div class="grid gap-6 lg:grid-cols-2">{others.map(p => <CardBlog blogEntry={p} />)}</div>
    </section>
  )}
  <CTASection />
</MainLayout>
