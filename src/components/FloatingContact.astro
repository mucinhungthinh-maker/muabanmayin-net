---
import { site } from '../data/site';
---

<!-- Mobile: thanh Gọi/Zalo cố định đáy màn hình. Desktop: 2 nút tròn góc phải. -->
<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-px bg-slate-200 shadow-[0_-2px_10px_rgba(0,0,0,.12)] md:inset-x-auto md:right-4 md:bottom-4 md:flex md:flex-col md:gap-2 md:bg-transparent md:shadow-none">
  <a href={`tel:${site.hotlineTel}`} class="flex items-center justify-center gap-2 bg-accent py-3 text-base font-bold text-slate-900 md:rounded-full md:px-5 md:shadow-lg">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" /></svg>
    Gọi {site.hotline}
  </a>
  <a href={site.zalo} rel="nofollow noopener" class="flex items-center justify-center gap-2 bg-brand py-3 text-base font-bold text-white md:rounded-full md:px-5 md:shadow-lg">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3C6.5 3 2 6.9 2 11.7c0 2.7 1.4 5.1 3.7 6.7L5 21.5l3.5-1.8c1.1.3 2.3.5 3.5.5 5.5 0 10-3.9 10-8.7S17.5 3 12 3z" /></svg>
    Chat Zalo
  </a>
</div>
