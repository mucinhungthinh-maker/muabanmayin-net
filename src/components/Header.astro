---
import { site, nav } from '../data/site';
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3">
    <a href="/" class="flex flex-col leading-tight">
      <span class="text-lg font-extrabold text-brand">{site.shortBrand}</span>
      <span class="text-xs text-slate-600">Sửa · Mua bán · Thu mua máy in</span>
    </a>
    <nav class="ml-auto hidden lg:block" aria-label="Menu chính">
      <ul class="flex items-center gap-5 font-medium">
        {nav.map((n) => (
          <li>
            <a href={n.href} class:list={['hover:text-brand', path.startsWith(n.href) && 'text-brand']} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a href={`tel:${site.hotlineTel}`} class="ml-auto hidden rounded-lg bg-accent px-4 py-2 font-bold text-slate-900 hover:bg-amber-400 sm:inline-block lg:ml-0">
      Gọi {site.hotline}
    </a>
    <button id="menu-btn" type="button" class="ml-auto rounded-lg border border-slate-300 px-3 py-2 sm:ml-0 lg:hidden" aria-expanded="false" aria-controls="menu-mobile">
      <span class="sr-only">Mở menu</span>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
    </button>
  </div>
  <nav id="menu-mobile" class="hidden border-t border-slate-200 lg:hidden" aria-label="Menu di động">
    <ul class="mx-auto max-w-6xl px-4 py-2">
      {nav.map((n) => (
        <li><a href={n.href} class="block py-3 text-base font-medium">{n.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('menu-mobile');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
