---
import MainLayout from '@/layouts/MainLayout.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import { site } from '@data/site';

const { copy: t } = Astro.locals;
const copy = t.notFound;
---

<MainLayout title={`${copy.title} | Máy In Tô Ký`} description={copy.subTitle} noindex hideFooter>
  <section class="min-h-[calc(100svh-5.5rem)]" aria-labelledby="subtitle">
    <div class="pointer-events-none fixed inset-0 z-10 grid place-content-center px-4">
      <div class="pointer-events-auto mx-auto max-w-(--breakpoint-sm) text-center">
        <p class="mb-4 text-7xl font-extrabold text-yellow-500 lg:text-9xl dark:text-yellow-400">404</p>
        <h1 id="subtitle" class="mb-4 text-3xl font-bold tracking-tight text-balance text-neutral-700 md:text-4xl dark:text-neutral-300">
          {copy.subTitle}
        </h1>
        <p class="mb-6 text-lg text-pretty text-neutral-600 dark:text-neutral-400">{copy.content}</p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <PrimaryCTA title={copy.goHome} url="/" variant="yellow" noArrow />
          <PrimaryCTA title={`${t.contact.call} ${site.hotline}`} url={`tel:${site.hotlineTel}`} />
        </div>
      </div>
    </div>
  </section>
</MainLayout>
