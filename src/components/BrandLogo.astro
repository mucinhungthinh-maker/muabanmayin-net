---
// Logo chữ tạm: biểu tượng máy in + tên chi nhánh. Thay bằng logo thật khi có.
import { site } from '@data/site';
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2', className]}>
  <svg viewBox="0 0 48 48" class="h-9 w-9 shrink-0" aria-hidden="true">
    <rect width="48" height="48" rx="12" class="fill-neutral-800 dark:fill-neutral-200"></rect>
    <rect x="14" y="9" width="20" height="10" rx="1.5" class="fill-yellow-400"></rect>
    <rect x="8" y="17" width="32" height="16" rx="4" class="fill-neutral-50 dark:fill-neutral-800"></rect>
    <rect x="14" y="27" width="20" height="12" rx="1.5" class="fill-yellow-400"></rect>
    <circle cx="34" cy="22.5" r="1.8" class="fill-orange-400"></circle>
  </svg>
  <span class="flex flex-col leading-none">
    <span class="text-lg font-extrabold tracking-tight text-neutral-800 dark:text-neutral-200">
      {site.shortBrand}
    </span>
    <span class="mt-1 text-[11px] font-medium text-neutral-600 dark:text-neutral-400">
      Sửa · Mua bán · Thu mua máy in
    </span>
  </span>
</span>
