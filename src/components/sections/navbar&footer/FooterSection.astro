---
import FooterSocialLink from '@components/ui/links/FooterSocialLink.astro';
import Icon from '@components/ui/icons/Icon.astro';
import BrandLogo from '@components/BrandLogo.astro';
import { footerSections } from '@data/navigation';
import { site, fullAddress } from '@data/site';

const { copy: t } = Astro.locals;
const footer = t.nav.footer;
const socialIconClass = 'h-4 w-4 shrink-0 text-neutral-700 dark:text-neutral-400';
const linkClass =
  'inline-flex gap-x-2 rounded-lg text-neutral-600 ring-zinc-500 outline-hidden transition duration-300 hover:text-neutral-500 focus-visible:ring-3 dark:text-neutral-400 dark:ring-zinc-200 dark:hover:text-neutral-300';
---

<footer class="w-full bg-neutral-300 dark:bg-neutral-900">
  <div class="mx-auto w-full max-w-[85rem] px-4 py-10 sm:px-6 lg:px-16 lg:pt-20 2xl:max-w-(--breakpoint-2xl)">
    <div class="grid grid-cols-2 gap-6 md:grid-cols-4 lg:grid-cols-5">
      <div class="col-span-full lg:col-span-1">
        <BrandLogo />
        <p class="mt-4 text-sm text-neutral-600 dark:text-neutral-400">
          {site.tagline}. {footer.memberOf} {site.owner}.
        </p>
      </div>

      {footerSections.map(section => (
        <div class="col-span-1">
          <h3 class="font-bold text-neutral-800 dark:text-neutral-200">
            {footer.sectionTitles[section.id]}
          </h3>
          <ul class="mt-3 grid space-y-3">
            {section.links.map(link => (
              <li>
                <a href={link.path} class={linkClass}>
                  {footer.links[link.id]}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="col-span-2">
        <h3 class="font-bold text-neutral-800 dark:text-neutral-200">
          {footer.contactTitle}
        </h3>
        <ul class="mt-3 grid space-y-3 text-neutral-600 dark:text-neutral-400">
          <li class="flex gap-x-2">
            <Icon name="phone" class="mt-0.5 h-5 w-5 shrink-0" />
            <a href={`tel:${site.hotlineTel}`} class="font-bold text-neutral-800 underline-offset-2 hover:underline dark:text-neutral-200">
              {site.hotline}
            </a>
            <span>(Zalo)</span>
          </li>
          <li class="flex gap-x-2">
            <Icon name="mapPin" class="mt-0.5 h-5 w-5 shrink-0" />
            <span>{fullAddress}</span>
          </li>
          <li class="flex gap-x-2">
            <Icon name="clock" class="mt-0.5 h-5 w-5 shrink-0" />
            <span>{site.hours.text}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-9 grid gap-y-2 sm:mt-12 sm:flex sm:items-center sm:justify-between sm:gap-y-0">
      <p class="text-sm text-neutral-600 dark:text-neutral-400">
        © {new Date().getFullYear()} {site.brand} — {site.domain}
      </p>
      <div>
        {site.social.facebook && (
          <FooterSocialLink url={site.social.facebook} label="Facebook">
            <Icon name="facebook" class={socialIconClass} title="Facebook" />
          </FooterSocialLink>
        )}
        {site.social.youtube && (
          <FooterSocialLink url={site.social.youtube} label="YouTube">
            <Icon name="share" class={socialIconClass} title="YouTube" />
          </FooterSocialLink>
        )}
      </div>
    </div>
  </div>
</footer>
