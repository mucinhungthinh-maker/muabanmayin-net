# Copy thành .env rồi điền. KHÔNG commit file .env (đã có trong .gitignore)

# Bot MỚI tạo ở @BotFather (không dùng chung bot kỹ thuật)
TELEGRAM_BOT_TOKEN=

# Khóa Google Gemini (aistudio.google.com → Get API key). Có thể dùng chung khóa với bot kỹ thuật.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Chat id nhóm nhân viên gửi bài (số âm, dạng -100...). Lấy bằng lệnh /id trong nhóm.
STAFF_GROUP_ID=

# User id quản lý được duyệt bài, cách nhau dấu phẩy. Lấy bằng /id. Mỗi quản lý phải /start bot ở chat riêng 1 lần.
ADMIN_IDS=

# 1 = duyệt xong tự build + git push; 0 = chỉ ghi bài vào máy (để test)
AUTO_PUSH=1
