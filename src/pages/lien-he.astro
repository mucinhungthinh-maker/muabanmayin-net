---
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumb from '@components/ui/blocks/Breadcrumb.astro';
import ContactSection from '@components/sections/misc/ContactSection.astro';
import { site } from '@data/site';

const crumbs = [{ name: 'Liên hệ', path: '/lien-he/' }];
---

<MainLayout
  title={`Liên hệ máy in Tô Ký Quận 12 – ${site.hotline}`}
  description={`Liên hệ sửa máy in, mua bán máy in cũ tại chi nhánh Tô Ký, Quận 12: hotline/Zalo ${site.hotline}, địa chỉ, giờ làm việc, bản đồ.`}
  breadcrumbs={crumbs}
>
  <Breadcrumb items={crumbs} />
  <ContactSection
    title="Liên hệ chi nhánh Tô Ký, Quận 12"
    subTitle="Gọi, nhắn Zalo hoặc mang máy đến trực tiếp — kỹ thuật viên kiểm tra và báo giá tại chỗ."
  />
</MainLayout>
